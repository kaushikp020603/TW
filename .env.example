# ── Required in production ──────────────────────────────────────────
# Admin dashboard password (/admin). You can change it later in Admin → Settings.
ADMIN_PASSWORD=

# Hosted database (Turso, SQLite-compatible, free tier). Leave BOTH empty for local development:
# the app then uses a local file at ./data/arcana.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public address of the site (used for sitemap, canonical links, share links and emails).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Protects the scheduled jobs (nightly backup, daily reminders) on Vercel Cron.
CRON_SECRET=

# ── Optional ────────────────────────────────────────────────────────
# AI Oracle chat (server-side only). Without it the Oracle uses built-in replies.
ANTHROPIC_API_KEY=
# ORACLE_MODEL=claude-haiku-5-5
# Email confirmations via Resend (free tier). Without it, WhatsApp is used.
RESEND_API_KEY=
# MAIL_FROM="Spill the Cards <you@yourdomain.com>"
